<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center" android:id="@id/LinearLayout01" android:background="@drawable/gi_background" android:layout_width="match_parent" android:layout_height="match_parent" style="@style/Theme.GameInstaller"
